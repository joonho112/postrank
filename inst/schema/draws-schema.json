      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "criterion_blocks"
            ]
          },
          {
            "required": [
              "finite_law"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "input_kind": {
          "const": "equal_weight_draws"
        },
        "dependence_mode": {
          "const": "criterionwise_expected_only"
        }
      },
      "required": [
        "criterion_blocks"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "joint_draws"
            ]
          },
          {
            "required": [
              "finite_law"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "input_kind": {
          "const": "exact_finite_posterior"
        },
        "dependence_mode": {
          "const": "joint_model"
        }
      },
