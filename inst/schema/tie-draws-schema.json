{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "tie-aware-input-0.1"
    },
    "input_kind": {
      "enum": [
        "equal_weight_draws",
        "exact_finite_posterior"
      ]
    },
    "dependence_mode": {
      "const": "joint_model"
    },
    "requested_functional": {
      "const": "expected_rank_loss"
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "criterion_ids": {
      "$ref": "#/$defs/ids"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      },
      "minItems": 1
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "identification": {
      "$ref": "#/$defs/identification"
    },
    "tie_policy": {
      "$ref": "#/$defs/tiePolicy"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "joint_draws": {
      "$ref": "#/$defs/jointDraws"
    },
    "finite_law": {
      "$ref": "#/$defs/finiteLaw"
    },
    "equality": {
      "$ref": "#/$defs/equality"
    }
  },
  "required": [
    "schema_version",
    "input_kind",
    "dependence_mode",
    "requested_functional",
    "entity_ids",
    "criterion_ids",
    "targets",
    "context",
    "identification",
    "tie_policy",
    "provenance",
    "equality"
