        },
        "estimand": {
          "$ref": "#/$defs/id"
        },
        "entity_population": {
          "$ref": "#/$defs/id"
        },
        "time_reference": {
          "$ref": "#/$defs/id"
        },
        "units": {
          "$ref": "#/$defs/id"
        },
        "source_transform": {
          "$ref": "#/$defs/id"
        },
        "identification_basis": {
          "$ref": "#/$defs/id"
        },
