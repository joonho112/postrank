  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:postrank:tie-aware:draws-contract:0.1",
  "title": "Explicit equality-neutral joint posterior-input structure",
  "description": "Opt-in joint equal-weight IID/MCMC draws or nonempirical exact finite integer-state law. Ties are declared genuine and structural equality classes are separately declared or derived. Numerical checks do not authenticate scientific declarations.",
  "oneOf": [
    {
      "properties": {
        "input_kind": {
          "const": "equal_weight_draws"
        },
        "dependence_mode": {
          "const": "joint_model"
        }
      },
      "required": [
        "joint_draws"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "criterion_blocks"
            ]
          },
          {
            "required": [
              "finite_law"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "input_kind": {
          "const": "exact_finite_posterior"
        },
        "dependence_mode": {
          "const": "joint_model"
        }
      },
      "required": [
        "finite_law"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "joint_draws"
            ]
          },
          {
            "required": [
              "criterion_blocks"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
