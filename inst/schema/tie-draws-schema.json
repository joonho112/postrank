        },
        "source_target_variable_id": {
          "$ref": "#/$defs/id"
        },
        "derivation_note": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "entity_id",
        "criterion_id",
        "source_target_variable_id",
        "derivation_note"
      ]
    },
    "drawIndex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/id"
        },
        "original_draw_id": {
          "$ref": "#/$defs/id"
        },
        "chain_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
