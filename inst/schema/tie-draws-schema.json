    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regime": {
          "enum": [
            "iid",
            "mcmc"
          ]
        },
        "target_distribution": {
          "const": "declared_posterior"
        },
        "equal_weight": {
          "const": true
        },
        "warmup_status": {
          "enum": [
            "not_applicable",
            "removed"
          ]
        },
        "sampling_provenance": {
          "$ref": "#/$defs/id"
        },
        "chain_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chainHistory"
          },
          "minItems": 0
        }
      },
      "required": [
        "regime",
        "target_distribution",
        "equal_weight",
        "warmup_status",
        "sampling_provenance",
        "chain_history"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "regime": {
                "const": "iid"
              }
            }
          },
          "then": {
            "properties": {
              "warmup_status": {
                "const": "not_applicable"
              },
              "chain_history": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "regime": {
                "const": "mcmc"
              }
            }
          },
          "then": {
            "properties": {
              "warmup_status": {
                "const": "removed"
              },
              "chain_history": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "axis_order": {
          "const": [
