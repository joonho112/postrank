        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "sampling": {
          "$ref": "#/$defs/sampling"
        },
        "draw_index": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drawIndex"
          },
          "minItems": 1
        },
        "variable_map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableMap"
          },
          "minItems": 2
        },
        "cross_criterion_joint_provenance": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
