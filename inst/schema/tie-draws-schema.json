        "note"
      ]
    },
    "tiePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule": {
          "const": "equality_neutral"
        },
        "declared": {
          "const": true
        },
        "justification": {
          "$ref": "#/$defs/id"
        },
        "observed_tie_action": {
          "const": "accept_declared_exact_equality"
        }
      },
      "required": [
        "rule",
        "declared",
        "justification",
        "observed_tie_action"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer": {
          "$ref": "#/$defs/id"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_hash": {
          "$ref": "#/$defs/id"
        },
        "construction_note": {
          "$ref": "#/$defs/id"
        },
        "created_at": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "producer",
        "artifact_id",
        "artifact_hash",
        "construction_note",
        "created_at"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "fit_id": {
          "$ref": "#/$defs/id"
        },
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "source_format": {
          "$ref": "#/$defs/id"
        },
        "source_artifact": {
          "$ref": "#/$defs/id"
        },
        "source_hash": {
          "$ref": "#/$defs/id"
        },
        "vector_generation_provenance": {
          "$ref": "#/$defs/id"
        },
        "within_criterion_joint_declared": {
          "const": true
        }
