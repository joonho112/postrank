        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "sampling": {
          "$ref": "#/$defs/sampling"
        },
        "draw_index": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drawIndex"
          },
