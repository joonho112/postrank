            },
            "n": {
              "type": "integer",
              "minimum": 2
            }
          },
          "required": [
            "S",
            "n"
          ]
        },
        "dimnames": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "draw": {
              "$ref": "#/$defs/ids"
            },
            "entity": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "minItems": 2,
              "uniqueItems": true
            }
          },
          "required": [
            "draw",
            "entity"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2
          },
          "minItems": 1
        }
      },
      "required": [
        "axis_order",
        "shape",
        "dimnames",
        "values"
      ]
    },
    "jointDraws": {
