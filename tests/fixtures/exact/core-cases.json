{
  "schema": "p1-applied-tiny-oracle-v1",
  "scope": "NARROW executable oracle fixture, not the full draws-schema.json input validator or a production API",
  "semantics": {
    "theta_layout": "state -> entity -> criterion; larger target means higher priority",
    "grade_direction": "smaller grade means higher priority",
    "posterior": "positive integer state masses divided by the common denominator; coherent tie-free finite law",
    "rationals": "weights, tau, and q are exact canonical integer or integer/fraction strings",
    "relation_key": "comma-separated sign(g_j-g_i) for i<j in lexicographic pair order",
    "minimax_expected": "maximum of posterior expected criterion losses, not expectation of statewise maximum"
  },
  "limits": {
    "max_n": 4,
    "max_K": 3,
    "max_states": 12,
    "max_cases": 6,
    "max_settings_per_case": 8,
    "max_abs_target": 1000000,
    "max_denominator": 1000000,
    "max_rational_component": 1000000,
    "json_safe_integer_max": 9007199254740991
  },
